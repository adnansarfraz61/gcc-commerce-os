APP_NAME="GCC Commerce OS"
APP_ENV=local
DEBUG=true
API_PREFIX=/api
LOG_LEVEL=INFO

DATABASE_URL=postgresql+asyncpg://gcc:gcc@postgres:5432/gcc_commerce_os
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
REDIS_URL=redis://redis:6379/0

SECRET_KEY=change-me-in-production
TOKEN_ENCRYPTION_KEY=change-me-for-token-encryption
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
OAUTH_STATE_EXPIRE_MINUTES=15

BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8000"]

AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
AMAZON_REDIRECT_URI=http://localhost:8000/api/auth/amazon/callback
AMAZON_LWA_AUTH_URL=https://www.amazon.com/ap/oa
AMAZON_LWA_TOKEN_URL=https://api.amazon.com/auth/o2/token
AMAZON_LWA_SCOPES=profile
AMAZON_DEFAULT_MARKETPLACE_ID=A2VIGQ35RCS4UG
AMAZON_SP_API_REGION=eu-west-1
AMAZON_SP_API_ENDPOINT=https://sellingpartnerapi-eu.amazon.com
AMAZON_SP_API_APPLICATION_ID=
AMAZON_AWS_ACCESS_KEY_ID=
AMAZON_AWS_SECRET_ACCESS_KEY=
AMAZON_AWS_SESSION_TOKEN=
AMAZON_AWS_ROLE_ARN=

NOON_CLIENT_ID=
NOON_CLIENT_SECRET=
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
TIKTOK_SHOP_CLIENT_ID=
TIKTOK_SHOP_CLIENT_SECRET=
